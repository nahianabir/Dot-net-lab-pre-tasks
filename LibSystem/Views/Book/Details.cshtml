@model LibSystem.Data.Entities.Book

<h2>Book Details</h2>

<p>
    <strong>Title:</strong>
    @Model.Title
</p>

<p>
    <strong>Author:</strong>
    @Model.Author
</p>

<p>
    <strong>Category:</strong>
    @Model.Category.Name
</p>

<p>
    <strong>Price:</strong>
    @Model.Price
</p>

<p>
    <strong>Available Copies:</strong>
    @Model.AvailableCopies
</p>

@if (Model.AvailableCopies > 0)
{
    <a asp-controller="Borrow"
       asp-action="Create"
       asp-route-bookId="@Model.Id">
        Borrow Book
    </a>
}
else
{
    <p>Book is currently unavailable.</p>
}