@model List<LibSystem.Data.Entities.Book>

@{
    ViewData["Title"] = "Books";
}

<h2>Available Books</h2>

<table border="1">

    <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Category</th>
        <th>Available</th>
        <th>Action</th>
    </tr>

    @foreach (var book in Model)
    {
        <tr>

            <td>
                @book.Title
            </td>

            <td>
                @book.Author
            </td>

            <td>
                @book.Category.Name
            </td>

            <td>
                @book.AvailableCopies
            </td>

            <td>
                <a asp-controller="Book"
                   asp-action="Details"
                   asp-route-id="@book.Id">
                    Details
                </a>
            </td>

        </tr>
    }

</table>

<br />

<a asp-controller="Account"
   asp-action="Logout">
    Logout
</a>