@model List<Faculty>

<h4>Faculty List</h4>

<table class="table table-striped">
	<tr>
		<th>ID</th>
		<th>Title</th>
	</tr>

	@foreach (var fac in Model)
	{
		<tr>
			<td>@fac.Id</td>
			<td>@fac.Title</td>
			<td>
				<a asp-action="Delete" asp-controller="Faculty" asp-route-fid="@fac.Id">Delete</a>
			</td>
		</tr>
	}
</table>
